# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Data Inclusion API
DATA_INCLUSION_API_URL=https://api.data.inclusion.beta.gouv.fr
DATA_INCLUSION_API_KEY=your-api-key

# Carif-Oref Configuration
CARIF_OREF_CSV_URL=https://www.intercariforef.org/dian/?...&excsv=1
CARIF_OREF_FETCH_INTERVAL_HOURS=1

# Vercel AI Gateway (for enrichment, langage_clair, translation)
VERCEL_AI_GATEWAY_URL=https://api.vercel.ai
VERCEL_AI_GATEWAY_KEY=your-gateway-key

# FastAPI Configuration
FASTAPI_ENV=development
FASTAPI_DEBUG=true
FASTAPI_LOG_LEVEL=INFO
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# n8n Configuration
N8N_URL=http://localhost:5678
N8N_API_KEY=your-n8n-api-key

# Editorial Team Configuration
EDITORIAL_TEAM_EMAIL=editorial@refugies.info
DIFF_REVIEW_AUTO_APPROVE_DELAY_HOURS=24

# Observability & Monitoring
SENTRY_DSN=https://your-sentry-dsn
DATADOG_API_KEY=your-datadog-key
LOG_LEVEL=INFO

# Database Configuration
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT=30

# Feature Flags
ENABLE_POLICY_VALIDATION=true
ENABLE_CARIF_OREF_RECONCILIATION=true
ENABLE_SMART_CATCHUP=true
ENABLE_AUTO_APPROVAL=true
ENABLE_MONITORING_DASHBOARD=true
